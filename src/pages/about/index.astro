---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import FriendLinkCard from "../../components/FriendLinkCard.astro";
import "../../styles/about.css";
import {
  getThemeSettings,
  type SiteSocialIconKey,
} from "../../lib/theme-settings";
const { settings } = getThemeSettings();
const resolvedSocialItems =
  settings.site.socialLinks.resolvedSocialItems.filter((item) => item.visible);
const friendLinks = settings.site.friendLinks.filter((item) => item.visible);
const aboutTitle = settings.page.about.title || "关于";
const aboutSubtitle = settings.page.about.subtitle;

type SocialActionItem = {
  key: string;
  href: string;
  label: string;
  title: string;
  icon: SiteSocialIconKey;
};

type ContactItem = {
  key: string;
  href: string;
  icon: SiteSocialIconKey;
  text: string;
};

const formatExternalLabel = (href: string): string => {
  try {
    const parsed = new URL(href);
    const path = parsed.pathname.replace(/^\/+|\/+$/g, "");
    return path || parsed.hostname;
  } catch {
    return href;
  }
};

const socialItems: SocialActionItem[] = [
  ...resolvedSocialItems.map((item) => ({
    key: item.id,
    href: item.href,
    label: item.label,
    title: item.label,
    icon: item.iconKey,
  })),
];

const contactItems: ContactItem[] = [
  ...resolvedSocialItems.map((item) => ({
    key: item.id,
    href: item.href,
    icon: item.iconKey,
    text:
      item.id === "email"
        ? item.href.replace(/^mailto:/i, "")
        : formatExternalLabel(item.href),
  })),
];
---

<BaseLayout title={aboutTitle} bodyClass="about-page">
  <div class="page-header page-header--about">
    <div class="page-heading">
      <h1 class="page-title">{aboutTitle}</h1>
      {
        aboutSubtitle ? (
          <span class="page-subtitle">{aboutSubtitle}</span>
        ) : null
      }
    </div>
    {
      socialItems.length ? (
        <div class="page-actions">
          {socialItems.map((item) => (
            <a
              class="icon-link"
              href={item.href}
              aria-label={item.title}
              title={item.title}
            >
              <BrandIcon name={item.icon} class="icon" />
            </a>
          ))}
        </div>
      ) : null
    }
  </div>
  <p class="about-intro-line">
    Hello 大家好，这里是哆哆啦(dodola)！
    <br /><br />
    最近正在经历学生->成熟的<del>牛马</del
    >程序员的过渡期，内容更新可能不太规律，但会尽量保持输出，并且会调整内容的比重，比如之前更新的很多内容都是我在打ACM竞赛时的题解和总结，未来可能会更多地分享一些简单的技术文章、读书笔记、以及一些生活中的小想法。
    <br /><br />
    目前本站的主要内容是观察这个intjer的20~30岁，未来是什么样呢0v0，我会变成什么样的人呢？下一个人生节点出现在哪里呢？我会活出什么样的人生呢？分からないよ~
    <br /><br />
    最后，经常刷新的地理ip是深圳~欢迎和我交流任何内容！欢迎互换友链uu~
  </p>
  <h2 class="section-title about-section-title">友链++</h2>
  <div class="site-friends">
    {
      friendLinks.length ? (
        friendLinks.map((item) => (
          <FriendLinkCard
            name={item.name}
            url={item.url}
            avatar={item.avatar}
            bio={item.bio}
          />
        ))
      ) : (
        <p class="site-friends-empty">
          友链施工中，欢迎通过下方联系方式交换友链。
        </p>
      )
    }
  </div>
